# Copy to .env.<target> (e.g. .env.dev) and fill in. .env.* is gitignored and
# never packaged (scripts/prepare_bundle.py skips .env*).
#   set -a; source .env.dev; set +a
# The Databricks CLI reads BUNDLE_VAR_<name> as the bundle variable <name>.

# Deploy identity (used by the CLAUDE.md deploy steps)
AXIOM_PROFILE=DEFAULT
# AXIOM_DEPLOY_USER=you@company.com   # default: current user of AXIOM_PROFILE

# App name (unique per workspace)
BUNDLE_VAR_app_name=axiom

# Required
BUNDLE_VAR_warehouse_id=
BUNDLE_VAR_gov_catalog=
BUNDLE_VAR_gov_schema=
BUNDLE_VAR_admin_emails=

# Optional
BUNDLE_VAR_discovery_catalogs=
BUNDLE_VAR_environment_label=
BUNDLE_VAR_emet_catalog=not-configured
BUNDLE_VAR_ai_generation_endpoint=databricks-claude-sonnet-4-6
BUNDLE_VAR_lineage_lookback_days=365

# Axiom AI via Genie (dev target binds the Genie space: required there)
BUNDLE_VAR_axiom_ai_provider=local
BUNDLE_VAR_genie_space_id=not-configured
BUNDLE_VAR_axiom_ai_require_benchmark=false

# Lakebase (dev target binds a Lakebase database: required there)
BUNDLE_VAR_lakebase_enabled=false
BUNDLE_VAR_lakebase_endpoint_name=not-configured
BUNDLE_VAR_lakebase_branch=not-configured
BUNDLE_VAR_lakebase_database_resource=not-configured
BUNDLE_VAR_lakebase_schema=axiom_app

# Live QA scripts (frontend/scripts/*_live_qa.mjs)
AXIOM_BASE_URL=
AXIOM_QA_USER_EMAIL=

# Seed scripts (scripts/seed_*.py) also read AXIOM_PROFILE + BUNDLE_VAR_warehouse_id
AXIOM_SEED_ACTOR=

# AI governance extension (docs/ai_extension/DESIGN.md section 12)
BUNDLE_VAR_ai_features_enabled=false
BUNDLE_VAR_ai_intake_tag_key=edw_intake_id
BUNDLE_VAR_ai_tier_tag_key=ai_risk_tier
BUNDLE_VAR_ai_catalog_allowlist=
BUNDLE_VAR_ai_tool_schema_allowlist=
BUNDLE_VAR_ai_intake_grace_days=30
# Staging/prod only: the collector SP application ID. Leave commented out to
# run as the deploying identity (an empty value would break run_as).
# BUNDLE_VAR_ai_collector_sp=
BUNDLE_VAR_ai_job_schedule_pause_status=PAUSED
